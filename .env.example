# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending order confirmation emails.
# Get your key at https://resend.com
RESEND_API_KEY=

# EMAIL_FROM: The verified sender email address in Resend.
# If using the default onboarding@resend.dev, you can only send to your own email.
# Verify a domain at https://resend.com/domains to send to any email.
EMAIL_FROM=onboarding@resend.dev
