# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending order confirmation emails.
# Get your key at https://resend.com
RESEND_API_KEY=

# EMAIL_FROM: The verified sender email address in Resend.
# If using the default onboarding@resend.dev, you can only send to your own email.
# Verify a domain at https://resend.com/domains to send to any email.
EMAIL_FROM=onboarding@resend.dev

# SECURE_THRESHOLD: The order total that triggers routing to secure wallets.
# Default is 1500.
SECURE_THRESHOLD=1500

# SECURE_WALLET_BTC: Private wallet address for high-value BTC transactions.
# These are hidden from the Admin Dashboard and only you can see/edit them in the Secrets panel.
SECURE_WALLET_BTC=
SECURE_WALLET_ETH=
SECURE_WALLET_USDT=
SECURE_WALLET_LTC=

# Optional: Secure QR codes for high-value transactions.
SECURE_QR_BTC=
SECURE_QR_ETH=
SECURE_QR_USDT=
SECURE_QR_LTC=
